</tr>
<tr>
<td><code>.epub</code></td>
<td>电子出版（EPUB）</td>
<td><code>application/epub+zip</code></td>
</tr>
<tr>
<td><code>.gz</code></td>
<td>GZip 压缩归档</td>
<td><code>application/gzip</code></td>
</tr>
<tr>
<td><code>.gif</code></td>
<td>图像互换格式（GIF）</td>
<td><code>image/gif</code></td>
</tr>
<tr>
<td><code>.htm</code>, <code>.html</code></td>
<td>超文本标记语言（HTML）</td>
<td><code>text/html</code></td>
</tr>
<tr>
<td><code>.ico</code></td>
<td>图标（Icon）格式</td>
<td><code>image/vnd.microsoft.icon</code></td>
</tr>
<tr>
<td><code>.ics</code></td>
<td>iCalendar 格式</td>
<td><code>text/calendar</code></td>
</tr>
<tr>
<td><code>.jar</code></td>
<td>Java 归档（JAR）</td>
