</tr>
<tr>
<td><code>.mp3</code></td>
<td>MP3 音频</td>
<td><code>audio/mpeg</code></td>
</tr>
<tr>
<td><code>.mp4</code></td>
<td>MP4 视频</td>
<td><code>video/mp4</code></td>
</tr>
