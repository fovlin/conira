<td><code>.mpeg</code></td>
<td>MPEG 视频</td>
<td><code>video/mpeg</code></td>
</tr>
<tr>
<td><code>.mpkg</code></td>
<td>Apple 安装包</td>
<td><code>application/vnd.apple.installer+xml</code></td>
</tr>
<tr>
<td><code>.odp</code></td>
<td>开放文档演示稿文档</td>
